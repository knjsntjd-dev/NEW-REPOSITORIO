{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-yt-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    box-sizing: border-box;
    background-color: {{ block.settings.background_color }};
    position: relative;
  }

  .ai-yt-gallery-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-yt-gallery-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
    width: 100%;
  }

  .ai-yt-video-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_desktop }});
    display: flex;
    flex-direction: column;
  }

  .ai-yt-video-wrap-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    height: 0;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background: #000000;
  }

  .ai-yt-video-wrap-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ai-yt-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: {{ block.settings.arrow_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-yt-nav-button-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-yt-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-yt-nav-button-{{ ai_gen_id }}.ai-yt-prev-{{ ai_gen_id }} {
    left: {{ block.settings.arrow_offset }}px;
  }

  .ai-yt-nav-button-{{ ai_gen_id }}.ai-yt-next-{{ ai_gen_id }} {
    right: {{ block.settings.arrow_offset }}px;
  }

  .ai-yt-nav-button-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  @media screen and (max-width: 749px) {
    .ai-yt-video-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_mobile }});
    }

    .ai-yt-nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-yt-nav-button-{{ ai_gen_id }}.ai-yt-prev-{{ ai_gen_id }} {
      left: {{ block.settings.arrow_offset | times: 0.5 }}px;
    }

    .ai-yt-nav-button-{{ ai_gen_id }}.ai-yt-next-{{ ai_gen_id }} {
      right: {{ block.settings.arrow_offset | times: 0.5 }}px;
    }
  }
{% endstyle %}

<youtube-gallery-{{ ai_gen_id }} class="ai-yt-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-yt-gallery-container-{{ ai_gen_id }}">
    <div class="ai-yt-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign video_url = block.settings[video_url_key]
        %}

        {% if video_url != blank %}
          <div class="ai-yt-video-item-{{ ai_gen_id }}">
            <div class="ai-yt-video-wrap-{{ ai_gen_id }}">
              <iframe
                src="{{ video_url }}"
                title="Video {{ i }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_arrows %}
      <button class="ai-yt-nav-button-{{ ai_gen_id }} ai-yt-prev-{{ ai_gen_id }}" aria-label="Previous videos">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-yt-nav-button-{{ ai_gen_id }} ai-yt-next-{{ ai_gen_id }}" aria-label="Next videos">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}
  </div>
</youtube-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class YoutubeGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.convertYoutubeLinks();
        this.setupNavigation();
      }

      convertYoutubeLinks() {
        const iframes = this.querySelectorAll('iframe');
        iframes.forEach((iframe) => {
          let src = iframe.getAttribute('src');
          const autoplay = {{ block.settings.enable_autoplay | json }};
          const mute = {{ block.settings.mute_videos | json }};
          
          let embedUrl = '';
          let videoId = '';
          
          if (src && src.includes('youtube.com/watch?v=')) {
            videoId = new URL(src).searchParams.get('v');
            if (videoId) {
              embedUrl = `https://www.youtube.com/embed/${videoId}`;
            }
          } else if (src && src.includes('youtu.be/')) {
            videoId = src.split('youtu.be/')[1].split('?')[0].split('/')[0];
            if (videoId) {
              embedUrl = `https://www.youtube.com/embed/${videoId}`;
            }
          } else if (src && src.includes('youtube.com/shorts/')) {
            videoId = src.split('youtube.com/shorts/')[1].split('?')[0].split('/')[0];
            if (videoId) {
              embedUrl = `https://www.youtube.com/embed/${videoId}`;
            }
          } else if (src && src.includes('youtube.com/embed/')) {
            embedUrl = src.split('?')[0];
            videoId = embedUrl.split('/').pop();
          }

          if (embedUrl && videoId) {
            const params = new URLSearchParams();
            if (autoplay) params.append('autoplay', '1');
            if (mute) params.append('mute', '1');
            params.append('loop', '1');
            params.append('playlist', videoId);
            params.append('modestbranding', '1');
            params.append('showinfo', '0');
            params.append('rel', '0');
            params.append('controls', '0');
            params.append('iv_load_policy', '3');
            params.append('disablekb', '1');
            params.append('fs', '0');
            
            iframe.setAttribute('src', `${embedUrl}?${params.toString()}`);
          }
        });
      }

      setupNavigation() {
        const grid = this.querySelector('.ai-yt-gallery-grid-{{ ai_gen_id }}');
        const prevButton = this.querySelector('.ai-yt-prev-{{ ai_gen_id }}');
        const nextButton = this.querySelector('.ai-yt-next-{{ ai_gen_id }}');
        const items = this.querySelectorAll('.ai-yt-video-item-{{ ai_gen_id }}');
        
        if (!grid || !prevButton || !nextButton || items.length === 0) return;

        const columnsDesktop = {{ block.settings.columns_desktop }};
        const columnsMobile = {{ block.settings.columns_mobile }};
        const gap = {{ block.settings.gap }};

        const updateButtons = () => {
          const isMobile = window.innerWidth <= 749;
          const columns = isMobile ? columnsMobile : columnsDesktop;
          const maxIndex = Math.max(0, items.length - columns);
          
          prevButton.disabled = this.currentIndex === 0;
          nextButton.disabled = this.currentIndex >= maxIndex;
        };

        const slide = () => {
          const isMobile = window.innerWidth <= 749;
          const columns = isMobile ? columnsMobile : columnsDesktop;
          const itemWidth = items[0].offsetWidth;
          const offset = -(this.currentIndex * (itemWidth + gap));
          
          grid.style.transform = `translateX(${offset}px)`;
          updateButtons();
        };

        prevButton.addEventListener('click', () => {
          if (this.currentIndex > 0) {
            this.currentIndex--;
            slide();
          }
        });

        nextButton.addEventListener('click', () => {
          const isMobile = window.innerWidth <= 749;
          const columns = isMobile ? columnsMobile : columnsDesktop;
          const maxIndex = Math.max(0, items.length - columns);
          
          if (this.currentIndex < maxIndex) {
            this.currentIndex++;
            slide();
          }
        });

        window.addEventListener('resize', () => {
          slide();
        });

        updateButtons();
      }
    }

    customElements.define('youtube-gallery-{{ ai_gen_id }}', YoutubeGallery{{ ai_gen_id }});
  })();
</script>

