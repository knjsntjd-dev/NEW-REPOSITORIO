<header class="color-{{ section.settings.color_scheme }}" style="background:var(--grad,rgb(var(--bg)))">
  <div class="page-width flex" style="justify-content:space-between;padding-top:2rem;padding-bottom:2rem">
    <h1 class="header__logo" style="margin:0">
      {%- if settings.logo != blank -%}
        {%- assign lw = settings.logo_width -%}
        {{ settings.logo | image_url: width: 600 | image_tag: width: lw, alt: shop.name, style: 'height:auto' }}
      {%- else -%}{{ shop.name }}{%- endif -%}
    </h1>
    <details class="facet">
      <summary>{{ 'general.password_page.login_password_button' | t }}</summary>
      <div class="facet__panel" style="right:0;left:auto;min-width:30rem">
        {%- form 'storefront_password', class: 'stack' -%}
          <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
          {%- if form.errors -%}<p class="form-status form-status--error">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
          <button type="submit" class="btn btn--full">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- endform -%}
        <p style="font-size:1.2rem;margin-top:1rem">{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </details>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.main-password-header.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-password-header.settings.logo_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-password-header.settings.logo_help.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
