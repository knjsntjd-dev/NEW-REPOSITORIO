<div class="section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="page-width customer">
    <p><a href="{{ routes.account_url }}" class="link">{{ 'customer.account.return' | t }}</a></p>
    <h1 class="h1">{{ 'customer.addresses.title' | t }}</h1>
    <details class="accordion">
      <summary><span class="accordion__title">{{ 'customer.addresses.add_new' | t }}</span></summary>
      <div class="accordion__content">
        {%- form 'customer_address', customer.new_address -%}
          {% render 'address-form', form: form, id: 'new' %}
          <button class="btn">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </div>
    </details>
    {%- paginate customer.addresses by 20 -%}
      {%- for address in customer.addresses -%}
        <div class="mc__item--boxed" style="margin-top:2rem">
          {%- if address == customer.default_address -%}<p class="badge badge--sale">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
          {{ address | format_address }}
          <details class="accordion" style="margin-top:1rem">
            <summary><span class="accordion__title">{{ 'customer.addresses.edit' | t }}</span></summary>
            <div class="accordion__content">
              {%- form 'customer_address', address -%}
                {% render 'address-form', form: form, id: address.id %}
                <button class="btn">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </div>
          </details>
          <form method="post" action="{{ address.url }}" onsubmit="return confirm({{ 'customer.addresses.delete_confirm' | t | json | escape }})" style="margin-top:1rem">
            <input type="hidden" name="_method" value="delete">
            <button class="link" type="submit">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </div>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>
<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script>
  addEventListener('DOMContentLoaded',function(){document.querySelectorAll('[data-country]').forEach(function(c){var id=c.dataset.id;if(window.Shopify&&Shopify.CountryProvinceSelector){new Shopify.CountryProvinceSelector('Country_'+id,'Province_'+id,{hideElement:'ProvinceWrap_'+id})}})});
</script>

{% schema %}
{
  "name": "t:sections.main-addresses.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
