{%- comment -%} Resumo do carrinho (página /cart). Blocos: discount_field, subtotal, buttons, @app {%- endcomment -%}
<div class="page-width" style="padding-bottom:4rem">
  <div data-cart-section="{{ section.id }}">
    {%- if cart.item_count > 0 -%}
      <div class="cart-page" style="grid-template-columns:1fr">
        <div style="max-width:44rem;margin-left:auto;width:100%">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
          {% render 'cart-summary', is_page: true %}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "blocks": [
    {
      "type": "discount_field",
      "name": "Discount field",
      "limit": 1
    },
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
