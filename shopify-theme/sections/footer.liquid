{%- assign s = section.settings -%}
<footer class="footer color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;margin-top:{{ s.margin_top }}px">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="footer__block" style="--wd:{{ b.width_desktop | default: 3 }};--wm:{{ b.width_mobile | default: 2 }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'link_list' -%}
                {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
                <ul role="list">
                  {%- for link in b.menu.links -%}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{%- endfor -%}
                </ul>
              {%- when 'brand_information' -%}
                {%- if settings.brand_image != blank -%}
                  {%- capture bw -%}{{ settings.brand_image_width }}px{%- endcapture -%}
                  {{ settings.brand_image | image_url: width: 600 | image_tag: loading: 'lazy', width: settings.brand_image_width, sizes: bw, widths: '200,400,600', style: 'margin-bottom:1.6rem;height:auto' }}
                {%- endif -%}
                {%- if settings.brand_headline != blank -%}<h2>{{ settings.brand_headline }}</h2>{%- endif -%}
                {%- if settings.brand_description != blank -%}<div class="rte">{{ settings.brand_description }}</div>{%- endif -%}
                {%- if b.show_social -%}{% render 'social-icons' %}{%- endif -%}
              {%- when 'text' -%}
                {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
                <div class="rte">{{ b.subtext }}</div>
              {%- when 'image' -%}
                {%- if b.image != blank -%}
                  {%- capture iw -%}width:{{ b.image_width }}%;{% if b.alignment == 'center' %}margin:0 auto{% elsif b.alignment == 'right' %}margin-left:auto{% endif %}{%- endcapture -%}
                  {%- if b.url != blank -%}<a href="{{ b.url }}">{%- endif -%}
                  {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200,400,600,800', sizes: '(min-width: 750px) 25vw, 50vw', style: iw }}
                  {%- if b.url != blank -%}</a>{%- endif -%}
                {%- endif -%}
              {%- when 'email_signup' -%}
                {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
                {%- if b.subtext != blank -%}<div class="rte" style="margin-bottom:1.2rem">{{ b.subtext }}</div>{%- endif -%}
                {% render 'newsletter-form', id: block.id, label: b.button_label, secondary: b.button_style_secondary %}
              {%- when 'featured_product' -%}
                {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
                {%- if b.product != blank -%}{% render 'card-product', card_product: b.product, show_secondary_image: b.second_image, scheme: b.color_scheme, sizes: '300px' %}{%- endif -%}
              {%- when 'featured_collection' -%}
                {%- if b.heading != blank -%}<h2>{{ b.heading }}</h2>{%- endif -%}
                {%- if b.collection != blank -%}{% render 'card-collection', collection: b.collection, ratio: b.image_ratio %}{%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign has_brand = section.blocks | where: 'type', 'brand_information' | size
    -%}
    {%- if s.show_social and has_brand == 0 -%}{% render 'social-icons' %}{%- endif -%}

    {%- if shop.features.follow_on_shop? and s.enable_follow_on_shop -%}
      <div style="margin-top:2rem">{{ shop | login_button: action: 'follow' }}</div>
    {%- endif -%}

    <div class="footer__bottom">
      <div>
        {%- if s.enable_country_selector or s.enable_language_selector -%}
          {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
            {%- form 'localization', class: 'localization' -%}
              {%- if s.enable_country_selector and localization.available_countries.size > 1 -%}
                <select name="country_code" class="select" data-autosubmit aria-label="{{ 'localization.country_label' | t }}">
                  {%- for c in localization.available_countries -%}<option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>{%- endfor -%}
                </select>
              {%- endif -%}
              {%- if s.enable_language_selector and localization.available_languages.size > 1 -%}
                <select name="locale_code" class="select" data-autosubmit aria-label="{{ 'localization.language_label' | t }}">
                  {%- for l in localization.available_languages -%}<option value="{{ l.iso_code }}" lang="{{ l.iso_code }}"{% if l.iso_code == localization.language.iso_code %} selected{% endif %}>{{ l.endonym_name | capitalize }}</option>{%- endfor -%}
                </select>
              {%- endif -%}
              <noscript><button class="btn">OK</button></noscript>
            {%- endform -%}
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if s.payment_enable -%}
        {%- liquid
          assign types = shop.enabled_payment_types
          if s.enabled_payment_types != blank
            assign types = s.enabled_payment_types | remove: ' ' | split: ','
          endif
        -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in types -%}<li>{{ type | strip | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="footer__bottom" style="border:0;margin-top:1rem;padding-top:0">
      <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}{% if s.branding_text != blank %} · {{ s.branding_text }}{% endif %}</small>
      {%- if s.show_policy -%}
        <nav class="footer__policies" aria-label="Policies">
          {%- for policy in shop.policies -%}{%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}{%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

