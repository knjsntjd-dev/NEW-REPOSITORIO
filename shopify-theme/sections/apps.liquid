{%- if section.settings.include_margins -%}<div class="page-width section" style="--pt:24px;--pb:24px">{%- endif -%}
{%- for block in section.blocks -%}{% render block %}{%- endfor -%}
{%- if section.settings.include_margins -%}</div>{%- endif -%}

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
