{%- liquid
  assign s = section.settings
  assign has_img = false
  if s.image != blank
    assign has_img = true
  endif
  capture container_style
    if s.container_color_scheme == 'custom'
      render 'custom-colors', bg: s.custom_contaner_colors_background, grad: s.custom_container_gradient_background, text: s.custom_contaner_colors_text
    endif
  endcapture
-%}
{%- assign extra_class = 'collapsible--' | append: s.layout -%}
<div {% render 'section-style', s: s, extra: extra_class %}>
  <div class="page-width">
    <div class="collapsible__grid{% if has_img %} collapsible__grid--img{% if s.desktop_layout == 'image_second' %} collapsible__grid--img-second{% endif %}{% endif %}">
      {%- if has_img -%}
        <div class="collapsible__img media" style="{% case s.image_ratio %}{% when 'small' %}aspect-ratio:1.5{% when 'large' %}aspect-ratio:.8{% else %}aspect-ratio:{{ s.image.aspect_ratio }}{% endcase %}">
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375,550,750,1000,1200', sizes: '(min-width: 750px) 50vw, 100vw' }}
        </div>
      {%- endif -%}
      <div>
        {%- if s.caption != blank or s.heading != blank -%}
          <div class="section-header" style="text-align:{{ s.heading_alignment }}">
            {%- if s.caption != blank -%}<p class="caption-with-letter-spacing">{{ s.caption | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="{{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="collapsible__container{% if s.layout != 'none' and s.container_color_scheme != 'custom' %} color-{{ s.container_color_scheme }}{% endif %}" style="{{ container_style }}">
          {%- for block in section.blocks -%}
            <details class="accordion{% if s.layout == 'row' and s.container_color_scheme != 'custom' %} color-{{ s.container_color_scheme }}{% endif %}"{% if s.layout == 'row' %} style="{{ container_style }}"{% endif %}{% if s.open_first_collapsible_row and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                {%- render 'icon-accordion', icon: block.settings.icon -%}
                <h3 class="accordion__title">{{ block.settings.heading | default: block.settings.page.title | escape }}</h3>
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.row_content }}
                {{ block.settings.page.content }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

