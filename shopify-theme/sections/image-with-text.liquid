{%- liquid
  assign s = section.settings
  case s.desktop_image_width
    when 'small'
      assign iw = '0.5fr'
    when 'large'
      assign iw = '1.5fr'
    else
      assign iw = '1fr'
  endcase
  case s.desktop_content_position
    when 'top'
      assign v = 'flex-start'
    when 'bottom'
      assign v = 'flex-end'
    else
      assign v = 'center'
  endcase
  assign items = s.desktop_content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  assign items_m = s.mobile_content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  assign sec_scheme = s.section_color_scheme | default: settings.color_schemes.first.id
  assign box_scheme = s.color_scheme | default: sec_scheme
-%}
<div class="section color-{{ sec_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px">
  <div class="page-width">
    <div class="iwt iwt--{{ s.height }}{% if s.layout == 'text_first' %} iwt--text-first{% endif %}{% if s.content_layout == 'overlap' %} iwt--overlap{% endif %}{% if box_scheme != sec_scheme %} iwt--boxed{% endif %}" style="--img-w:{{ iw }};--v:{{ v }};--align:{{ s.desktop_content_alignment }};--align-m:{{ s.mobile_content_alignment }};--items:{{ items }};--items-m:{{ items_m }}">
      <div class="iwt__media"{% if s.height == 'adapt' and s.image != blank %} style="aspect-ratio:{{ s.image.aspect_ratio }}"{% endif %}>
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '375,550,750,1000,1250,1500', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="iwt__content color-{{ box_scheme }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- when 'caption' -%}
              <p class="{{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }}</p>
            {%- when 'text' -%}
              <div class="rte{% if block.settings.text_style == 'subtitle' %} subtitle{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <a class="btn{% if block.settings.button_style_secondary %} btn--secondary{% endif %}" href="{{ block.settings.button_link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

