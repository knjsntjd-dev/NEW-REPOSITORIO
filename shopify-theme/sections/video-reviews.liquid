{%- liquid
  assign s = section.settings
  assign n = section.blocks.size
  assign half = n | divided_by: 2.0
  assign xs = '0,0.64,1.1,1.44' | split: ','
  assign ss = '1,0.86,0.74,0.64' | split: ','
  assign rys = '0,30,42,50' | split: ','
  assign tzs = '0,-50,-110,-170' | split: ','
  case s.card_ratio
    when '4/5'
      assign ratio = 1.25
    when '3/4'
      assign ratio = 1.3333
    else
      assign ratio = 1.7778
  endcase
  assign eager = false
  if section.index and section.index <= 2
    assign eager = true
  endif
  assign scheme = s.color_scheme | default: 'background-1'
-%}
<style>
  .vr{overflow:hidden}
  .vr .section-header{text-align:center}
  .vr__sub{margin:1rem 0 0;font-size:1.6rem}
  .vr__stage{--w:min(68vw,320px);--k:1.2;--ryk:.5;--zk:.5;position:relative;height:calc(var(--w) * var(--r));margin-top:3.2rem;touch-action:pan-y;outline:0;perspective:220rem}
  @media (min-width:750px){.vr__stage{--w:min(var(--cw),40vw);--k:1;--ryk:1;--zk:1;perspective:120rem}}
  .vr__list{list-style:none;margin:0;padding:0;height:100%;transform-style:preserve-3d}
  .vr__card{position:absolute;top:0;left:50%;width:var(--w);height:100%;margin-left:calc(var(--w) / -2);transform:translateX(calc(var(--x) * var(--w) * var(--k))) translateZ(calc(var(--tz) * var(--zk))) rotateY(calc(var(--ry) * var(--ryk))) scale(var(--s));transform-style:preserve-3d;backface-visibility:hidden;transition:transform .5s cubic-bezier(.22,.61,.36,1),opacity .3s,visibility .3s;cursor:pointer}
  .vr__card[data-a="0"]{cursor:default}
  .vr__card[data-a="h"]{opacity:0;visibility:hidden;pointer-events:none}
  @media (max-width:749px){.vr__card[data-a="2"],.vr__card[data-a="3"]{opacity:0;visibility:hidden;pointer-events:none}}
  .vr__media{position:relative;height:100%;border-radius:1.6rem;overflow:hidden;background:#d9d9d9;box-shadow:0 1rem 3rem rgba(0,0,0,.14)}
  .vr__media>img,.vr__media>svg,.vr__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .vr__media::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(0,0,0,.78),rgba(0,0,0,0) 52%)}
  .vr__media::after{content:"";position:absolute;inset:0;z-index:4;background:rgb(var(--bg));opacity:0;transition:opacity .3s;pointer-events:none}
  .vr__card[data-a="1"] .vr__media::after{opacity:.22}
  .vr__card[data-a="2"] .vr__media::after{opacity:.4}
  .vr__card[data-a="3"] .vr__media::after{opacity:.55}
  .vr__info{position:absolute;left:0;right:7.2rem;bottom:0;z-index:2;padding:2rem;color:#fff}
  .vr__name{display:flex;align-items:center;gap:.6rem;margin:0;font-size:2.4rem;font-weight:700;line-height:1.1;color:#fff}
  .vr__name svg{flex:none;width:1.8rem;height:1.8rem;color:var(--vr-accent)}
  .vr__text{margin:.6rem 0 0;font-size:1.4rem;line-height:1.35;color:rgba(255,255,255,.9)}
  .vr__link{display:inline-block;margin-top:.6rem;font-size:1.5rem;font-weight:600;color:var(--vr-accent);text-decoration:none}
  .vr__play{position:absolute;right:1.6rem;bottom:1.6rem;z-index:3;display:flex;align-items:center;justify-content:center;width:5.2rem;height:5.2rem;padding:0;border:1px solid rgba(255,255,255,.6);border-radius:1rem;background:rgba(0,0,0,.35);color:#fff;cursor:pointer;transition:background .2s}
  .vr__play:hover{background:rgba(0,0,0,.55)}
  .vr__play svg{width:2.2rem;height:2.2rem}
  .vr__video{z-index:5;background:#000}
  .vr__card.is-playing .vr__info,.vr__card.is-playing .vr__play{display:none}
  .vr__arrow{position:absolute;top:50%;z-index:20;display:none;align-items:center;justify-content:center;width:4.8rem;height:4.8rem;margin-top:-2.4rem;padding:0;border:0;border-radius:50%;background:#fff;color:#121212;box-shadow:0 .4rem 1.6rem rgba(0,0,0,.18);cursor:pointer}
  .vr__arrow svg{width:1.8rem;height:1.8rem}
  @media (min-width:750px){.vr__arrow{display:flex}.vr__arrow--prev{left:max(1.6rem,calc(50% - var(--w) * 1.3))}.vr__arrow--next{right:max(1.6rem,calc(50% - var(--w) * 1.3))}}
  @media (prefers-reduced-motion:reduce){.vr__card{transition:none}}
</style>

<div {% render 'section-style', s: s, extra: 'vr' %} data-vr>
  {%- if s.caption != blank or s.heading != blank or s.subheading != blank -%}
    <div class="page-width">
      <div class="section-header">
        {%- if s.caption != blank -%}<p class="caption-with-letter-spacing">{{ s.caption | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="{{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="vr__sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if n > 0 -%}
    <div class="vr__stage" data-vr-stage tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ s.heading | default: 'Vídeos' | escape }}" style="--cw:{{ s.card_width }}px;--r:{{ ratio }};--vr-accent:{{ s.accent_color }}">
      <ul class="vr__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign i = forloop.index0
            assign o = i
            if o > half
              assign o = o | minus: n
            endif
            assign ao = o | abs
            assign a = ao | at_most: 3
            assign x = xs[a]
            if o < 0
              assign x = '-' | append: x
            endif
            assign sc = ss[a]
            assign z = 10 | minus: a
            assign ry = rys[a]
            if o > 0
              assign ry = '-' | append: ry
            endif
            assign tz = tzs[a]
            if ao > 3
              assign da = 'h'
            else
              assign da = a
            endif

            assign src = ''
            if b.video != blank
              assign best = 0
              for so in b.video.sources
                if so.format == 'mp4' and so.height <= 720 and so.height > best
                  assign src = so.url
                  assign best = so.height
                endif
              endfor
              if src == ''
                for so in b.video.sources
                  if so.format == 'mp4'
                    assign src = so.url
                    break
                  endif
                endfor
              endif
            elsif b.video_url != blank
              capture src
                render 'video-rendition', url: b.video_url
              endcapture
            endif

            assign poster = b.image
            if poster == blank and b.video != blank
              assign poster = b.video.preview_image
            endif

            assign href = b.link
            if href == blank and b.product != blank
              assign href = b.product.url
            endif
            assign text = b.text
            if text == blank and b.product != blank
              assign text = b.product.title
            endif
            assign name = b.name | escape
          -%}
          <li class="vr__card" data-vr-card data-a="{{ da }}" style="--x:{{ x }};--s:{{ sc }};--ry:{{ ry }}deg;--tz:{{ tz }}px;z-index:{{ z }}"{% if src != blank %} data-src="{{ src }}"{% endif %}{% if o != 0 %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
            <div class="vr__media">
              {%- if poster != blank -%}
                {%- liquid
                  assign sizes = '(min-width: 750px) ' | append: s.card_width | append: 'px, 68vw'
                  if eager and o == 0
                    assign ld = 'eager'
                    assign fp = 'high'
                  else
                    assign ld = 'lazy'
                    assign fp = 'auto'
                  endif
                -%}
                {{ poster | image_url: width: 840 | image_tag: widths: '280,360,480,640,840', sizes: sizes, loading: ld, fetchpriority: fp, alt: name }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
              <div class="vr__info">
                {%- if b.name != blank -%}
                  <p class="vr__name">
                    {{ name }}
                    {%- if b.verified -%}
                      <svg viewBox="0 0 24 24" aria-label="Verificado" role="img"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17.2 8.8" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endif -%}
                  </p>
                {%- endif -%}
                {%- if text != blank -%}<p class="vr__text">{{ text | escape }}</p>{%- endif -%}
                {%- if href != blank and s.link_label != blank -%}
                  <a class="vr__link" href="{{ href }}"{% if o != 0 %} tabindex="-1"{% endif %}>{{ s.link_label | escape }} &rarr;</a>
                {%- endif -%}
              </div>
              {%- if src != blank -%}
                <button type="button" class="vr__play" data-vr-play aria-label="Reproduzir vídeo de {{ name }}"{% if o != 0 %} tabindex="-1"{% endif %}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                </button>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if n > 1 -%}
        <button type="button" class="vr__arrow vr__arrow--prev" data-vr-prev aria-label="{{ 'general.slider.previous_slide' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="vr__arrow vr__arrow--next" data-vr-next aria-label="{{ 'general.slider.next_slide' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      {%- endif -%}
    </div>
    <script src="{{ 'video-reviews.js' | asset_url }}" defer></script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Vídeos de clientes",
  "tag": "section",
  "class": "section-video-reviews",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Legenda",
      "default": "AVALIAÇÕES VERIFICADAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mais de 5.000 pessoas confiam em nós."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamanho do título",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Confira nossas avaliações e veja por si mesmo!"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Formato do vídeo",
      "options": [
        { "value": "9/16", "label": "Vertical (9:16)" },
        { "value": "3/4", "label": "Retrato (3:4)" },
        { "value": "4/5", "label": "Retrato (4:5)" }
      ],
      "default": "9/16"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Largura do card central (desktop)",
      "min": 260,
      "max": 440,
      "step": 10,
      "unit": "px",
      "default": 370
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver produto"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor do link e do selo verificado",
      "default": "#3B82F6"
    },
    {
      "type": "header",
      "content": "Cores e espaçamento"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "color",
      "id": "custom_colors_background",
      "label": "Cor de fundo (Custom)",
      "default": "#FBFBF6"
    },
    {
      "type": "color_background",
      "id": "custom_gradient_background",
      "label": "Gradiente de fundo (Custom)"
    },
    {
      "type": "color",
      "id": "custom_colors_text",
      "label": "Cor do texto (Custom)",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vídeo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo",
          "info": "Envie o vídeo pela Shopify. Ele só é baixado quando o cliente clica no play."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Ou URL do vídeo (.mp4)",
          "info": "Usado só se nenhum vídeo for enviado acima."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Capa",
          "info": "Opcional. Sem capa, usa a imagem de pré-visualização do vídeo."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome",
          "default": "Kim C."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Mostrar selo de verificado",
          "default": true
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "info": "Vazio = título do produto."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Vazio = link do produto."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vídeos de clientes",
      "blocks": [
        { "type": "video", "settings": { "name": "Ana F." } },
        { "type": "video", "settings": { "name": "Hanna G." } },
        { "type": "video", "settings": { "name": "Kim C." } },
        { "type": "video", "settings": { "name": "Paula D." } },
        { "type": "video", "settings": { "name": "Emily J." } }
      ]
    }
  ]
}
{% endschema %}
