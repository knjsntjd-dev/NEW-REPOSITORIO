{%- liquid
  assign s = section.settings
  case s.icon_size
    when 'small'
      assign is = '3.2rem'
    when 'large'
      assign is = '6rem'
    else
      assign is = '4.4rem'
  endcase
  assign tcols = s.columns_desktop | at_most: 3
-%}
<div {% render 'section-style', s: s %}>
  <div class="page-width">
    {%- if s.title != blank or s.text != blank -%}
      <div class="section-header center">
        {%- if s.title != blank -%}<h2 class="{{ s.heading_size }}">{{ s.title | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div data-slider>
      <ul class="grid{% if s.swipe_on_mobile %} slider--mobile{% endif %}" data-slider-track role="list" style="--cols:{{ s.columns_desktop }};--cols-t:{{ tcols }};--cols-m:{{ s.columns_mobile }};--align:center;--items:center;--is:{{ is }};--icon-c:var(--c-{{ s.icon_color }})">
        {%- for block in section.blocks -%}
          <li class="mc__item{% if s.background_style == 'primary' %} mc__item--boxed{% endif %}" {{ block.shopify_attributes }}>
            <span class="icon-bar__icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'icon-accordion', icon: block.settings.icon %}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="h4">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

