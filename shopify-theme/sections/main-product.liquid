{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  case s.media_size
    when 'small'
      assign media_w = '45%'
    when 'large'
      assign media_w = '62%'
    else
      assign media_w = '55%'
  endcase
  assign is_first = false
  if section.index == 1 or section.index0 == 0
    assign is_first = true
  endif
  assign sticky_block = section.blocks | where: 'type', 'sticky_atc' | first
-%}
<div
  class="page-width"
  data-product-root
  data-section="{{ section.id }}"
>
  <div
    class="product{% if s.media_position == 'right' %} product--media-right{% endif %}{% unless s.mobile_spacing %} product--flush{% endunless %}"
    style="--media-w:{{ media_w }};--pt:{{ s.desktop_padding_top }}px;--pb:{{ s.desktop_padding_bottom }}px;--pt-m:{{ s.mobile_padding_top }}px;--pb-m:{{ s.mobile_padding_bottom }}px;--media-radius-m:{{ s.mobile_media_corner_radius }}px"
  >
    <div class="product__media">
      {% render 'product-gallery', product: product, section: section, is_first: is_first %}
    </div>

    <div class="product__info{% if s.enable_sticky_info %} product__info--sticky{% endif %}" id="ProductInfo-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign mt = block.settings.margin_top | default: 0 | divided_by: 10.0 -%}
        {%- assign mb = block.settings.margin_bottom | default: 0 | divided_by: 10.0 -%}
        {%- capture spacing -%}--mt:{{ mt }}rem;--mb:{{ mb }}rem{%- endcapture -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'text' -%}
            <p class="product__block{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}" style="{{ spacing }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

          {%- when 'title' -%}
            <h1 class="product__title {{ block.settings.text_size }}{% if block.settings.uppercase_title %} uppercase{% endif %}" style="{{ spacing }};text-align:{{ block.settings.title_alignment }}" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            {%- liquid
              assign on_sale = false
              if current_variant.compare_at_price > current_variant.price
                assign on_sale = true
              endif
              assign pct = 0
              if on_sale
                assign pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
              endif
            -%}
            <div class="product__block" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <div class="price price--large{% if on_sale %} price--on-sale{% endif %}" data-price-root style="--price-color:var(--c-{{ block.settings.price_color }});--compare-color:var(--c-{{ block.settings.compare_price_color }})">
                {%- capture cmp -%}<s class="price__compare"{% unless on_sale %} hidden{% endunless %}><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ current_variant.compare_at_price | money }}</s>{%- endcapture -%}
                {%- if block.settings.layout == 'price_second' -%}{{ cmp }}{%- endif -%}
                <span class="price__sale">{{ current_variant.price | money }}</span>
                {%- if block.settings.layout != 'price_second' -%}{{ cmp }}{%- endif -%}
                {%- unless block.settings.hide_sale_badge -%}
                  <span class="badge badge--sale color-{{ settings.sale_badge_color_scheme }}" data-text="{{ settings.sale_badge_text | default: 'Sale' | escape }}"{% unless on_sale %} hidden{% endunless %}>{{ settings.sale_badge_text | default: 'Sale' | replace: '[percentage]', pct }}</span>
                {%- endunless -%}
              </div>
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="cart-note-tax" style="margin-top:.4rem">
                  {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'emoji_benefits' -%}
            <div class="product__block benefits rte" style="{{ spacing }}" {{ block.shopify_attributes }}>{{ block.settings.benefits }}</div>

          {%- when 'badges' -%}
            <ul class="product__block badge-pills" style="{{ spacing }}" role="list" {{ block.shopify_attributes }}>
              {%- for n in (1..4) -%}
                {%- liquid
                  assign bb = block.settings
                  assign ktxt = 'text_' | append: n
                  assign kico = 'icon_' | append: n
                  assign kbg = 'bg_' | append: n
                  assign kcol = 'color_' | append: n
                -%}
                {%- if bb[ktxt] != blank -%}
                  <li class="badge-pill" style="--bp-bg:{{ bb[kbg] }};--bp-color:{{ bb[kcol] }}">
                    {%- if bb[kico] != blank -%}<span class="badge-pill__icon" aria-hidden="true">{{ bb[kico] }}</span>{%- endif -%}
                    <span>{{ bb[ktxt] | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'checklist' -%}
            <ul class="product__block checklist" style="{{ spacing }};--cl-icon:{{ block.settings.icon_color }}" role="list" {{ block.shopify_attributes }}>
              {%- for n in (1..5) -%}
                {%- liquid
                  assign cb = block.settings
                  assign klabel = 'label_' | append: n
                  assign ktext = 'text_' | append: n
                -%}
                {%- if cb[klabel] != blank or cb[ktext] != blank -%}
                  <li class="checklist__item">
                    <span class="checklist__icon" aria-hidden="true">{% render 'icon', name: 'check', stroke: 3 %}</span>
                    <span class="checklist__text">
                      {%- if cb[klabel] != blank -%}<strong>{{ cb[klabel] | escape }}</strong>{%- endif -%}
                      {%- if cb[ktext] != blank -%} {{ cb[ktext] | escape }}{%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'delivery_row' -%}
            <div class="product__block delivery-row" style="{{ spacing }};--dr-dot:{{ block.settings.dot_color }}" {{ block.shopify_attributes }}>
              {%- if block.settings.delivery_text != blank -%}
                <span class="delivery-row__part">
                  <span class="delivery-row__dot" aria-hidden="true"></span>
                  {{ block.settings.delivery_text }}
                </span>
              {%- endif -%}
              {%- if block.settings.shipping_text != blank -%}
                <span class="delivery-row__part">
                  {%- render 'icon-accordion', icon: block.settings.shipping_icon -%}
                  {{ block.settings.shipping_text }}
                </span>
              {%- endif -%}
            </div>

          {%- when 'rating_stars' -%}
            {%- assign pct_r = block.settings.rating | times: 20 -%}
            <div class="product__block rating-row" style="{{ spacing }};justify-content:{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
              <span class="stars" style="--pct:{{ pct_r }}%;--size:{{ block.settings.size | divided_by: 10.0 }}rem;--star:{{ block.settings.star_color }};--star-bg:{% if block.settings.bg_stars_style == 'outlined' %}transparent;-webkit-text-stroke:1px {{ block.settings.star_color }}{% else %}{{ block.settings.bg_star_color }}{% endif %}" role="img" aria-label="{{ block.settings.rating }} / 5"></span>
              {%- if block.settings.label != blank -%}<p>{{ block.settings.label }}</p>{%- endif -%}
            </div>

          {%- when 'rating' -%}
            {%- if product.metafields.reviews.rating.value != blank -%}
              {%- assign r = product.metafields.reviews.rating.value -%}
              <div class="product__block rating-row" {{ block.shopify_attributes }}>
                <span class="stars" style="--pct:{{ r.rating | divided_by: r.scale_max | times: 100 }}%"></span>
                <p>{{ r.rating | round: 1 }} ({{ product.metafields.reviews.rating_count }})</p>
              </div>
            {%- endif -%}

          {%- when 'payment_badges' -%}
            {%- liquid
              assign types = shop.enabled_payment_types
              if block.settings.enabled_payment_types != blank
                assign types = block.settings.enabled_payment_types | remove: ' ' | split: ','
              endif
            -%}
            <ul class="product__block payment-icons" style="{{ spacing }}" role="list" {{ block.shopify_attributes }}>
              {%- for type in types -%}<li>{{ type | strip | payment_type_svg_tag }}</li>{%- endfor -%}
            </ul>

          {%- when 'custom_product_field' -%}
            <div class="product__block field" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <label for="cpf-{{ block.id }}">{{ block.settings.field_label }}</label>
              <input class="input" id="cpf-{{ block.id }}" type="text" name="properties[{{ block.settings.field_name | escape }}]" form="{{ form_id }}" placeholder="{{ block.settings.text_placeholder | escape }}">
            </div>

          {%- when 'estimated_shipping' -%}
            {%- liquid
              case block.settings.icon_size
                when 'small'
                  assign is = '2rem'
                when 'large'
                  assign is = '3.2rem'
                else
                  assign is = '2.6rem'
              endcase
              assign msg = block.settings.message | replace: '[start_date]', '<span data-ship-start></span>' | replace: '[end_date]', '<span data-ship-end></span>'
            -%}
            <div class="product__block shipping-est" data-ship data-min="{{ block.settings.min_shipping_days }}" data-max="{{ block.settings.max_shipping_days }}" data-format="{{ block.settings.date_format }}" data-days="{{ block.settings.days_labels | escape }}" data-months="{{ block.settings.months_labels | escape }}" style="{{ spacing }};--is:{{ is }};--ia:{% if block.settings.icon_alignment == 'middle' %}center{% else %}flex-start{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.display_icon -%}
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'icon', name: 'truck' %}
                {%- endif -%}
              {%- endif -%}
              <div class="rte">{{ msg }}</div>
            </div>

          {%- when 'reviews' -%}
            <div class="product__block mini-reviews" style="{{ spacing }};--aa:{% if block.settings.avatar_alignment == 'middle' %}center{% else %}flex-start{% endif %}" {{ block.shopify_attributes }}>
              {%- for n in (1..3) -%}
                {%- liquid
                  assign kt = 'text_' | append: n
                  assign ka = 'author_' | append: n
                  assign ki = 'image_' | append: n
                -%}
                {%- if block.settings[kt] != blank -%}
                  <div class="mini-review">
                    {%- if block.settings[ki] != blank -%}{{ block.settings[ki] | image_url: width: 100 | image_tag: loading: 'lazy', width: 44, height: 44, alt: block.settings[ka] }}{%- endif -%}
                    <div>
                      {%- if block.settings.display_stars -%}<span class="stars" style="--size:1.3rem;--star:{{ block.settings.star_color }}"></span>{%- endif -%}
                      <div class="rte">{{ block.settings[kt] }}</div>
                      <p class="mini-review__author">{{ block.settings[ka] }}</p>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              <div class="product__block" style="{{ spacing }};display:flex;justify-content:{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
                {%- capture img_style -%}width:{{ block.settings.width }}%;border-radius:{{ block.settings.border_radius }}px{%- endcapture -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300,500,750,1000', sizes: '(min-width: 750px) 40vw, 100vw', style: img_style }}
              </div>
            {%- endif -%}

          {%- when 'sku' -%}
            <p class="product__block{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}" style="{{ spacing }}" {{ block.shopify_attributes }}><span class="visually-hidden">{{ 'products.product.sku' | t }}:</span> <span data-sku>{{ current_variant.sku }}</span></p>

          {%- when 'inventory' -%}
            {%- if current_variant.inventory_management == 'shopify' -%}
              {%- liquid
                assign qty = current_variant.inventory_quantity
                assign dot = '#3ea44f'
                if qty <= 0
                  assign dot = '#c62828'
                elsif qty <= block.settings.inventory_threshold
                  assign dot = '#f5a623'
                endif
              -%}
              <p class="product__block inventory" style="{{ spacing }};--dot:{{ dot }}" {{ block.shopify_attributes }}>
                {%- if qty <= 0 -%}
                  {%- if current_variant.inventory_policy == 'continue' -%}{{ 'products.product.inventory_out_of_stock_continue_selling' | t }}{%- else -%}{{ 'products.product.inventory_out_of_stock' | t }}{%- endif -%}
                {%- elsif qty <= block.settings.inventory_threshold -%}
                  {%- if block.settings.show_inventory_quantity -%}{{ 'products.product.inventory_low_stock_show_count' | t: quantity: qty }}{%- else -%}{{ 'products.product.inventory_low_stock' | t }}{%- endif -%}
                {%- else -%}
                  {%- if block.settings.show_inventory_quantity -%}{{ 'products.product.inventory_in_stock_show_count' | t: quantity: qty }}{%- else -%}{{ 'products.product.inventory_in_stock' | t }}{%- endif -%}
                {%- endif -%}
              </p>
            {%- endif -%}

          {%- when 'quantity_selector' -%}
            {%- if block.settings.enable_quantity_discounts -%}
              {% render 'quantity-breaks', product: product, block: block, form_id: form_id, section: section %}
            {%- else -%}
              <div class="product__block" style="{{ spacing }}" {{ block.shopify_attributes }}>
                <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                <div class="qty">
                  <button type="button" data-qty-btn="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                  <input id="Qty-{{ section.id }}" type="number" name="quantity" value="{{ current_variant.quantity_rule.min }}" min="{{ current_variant.quantity_rule.min }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} step="{{ current_variant.quantity_rule.increment }}" form="{{ form_id }}">
                  <button type="button" data-qty-btn="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
                </div>
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {% render 'variant-picker', product: product, block: block, form_id: form_id, section: section %}

          {%- when 'buy_buttons' -%}
            <div class="product__block buy{% if block.settings.enable_custom_color %} buy--custom{% endif %}" style="{{ spacing }};--atc-bg:{{ block.settings.custom_color }};align-items:{% case block.settings.alignment %}{% when 'center' %}center{% when 'end' %}flex-end{% else %}stretch{% endcase %}" id="BuyButtons-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-product-form: '', data-skip-cart: block.settings.skip_cart -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}"{% if product.has_only_default_variant %} data-single{% endif %}>
                <button type="submit" name="add" class="btn btn--full btn--atc{% if block.settings.uppercase_text %} uppercase{% endif %}" data-atc{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>
                  <span data-atc-label>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                <p class="product-form__error" data-form-error role="alert" hidden></p>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__block rte" style="{{ spacing }}" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'share' -%}
            <div class="product__block" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <button type="button" class="share-btn" data-share="{{ request.origin }}{{ product.url }}">{% render 'icon', name: 'share', class: 'icon--small' %}{{ block.settings.share_label | escape }}</button>
              <span data-share-msg hidden>{{ 'general.share.success_message' | t }}</span>
            </div>

          {%- when 'custom_liquid' -%}
            <div class="product__block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

          {%- when 'collapsible_tab' -%}
            <details class="product__block accordion" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <summary>
                {%- render 'icon-accordion', icon: block.settings.icon -%}
                <h2 class="accordion__title">{{ block.settings.heading | default: block.settings.page.title | escape }}</h2>
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>

          {%- when 'popup' -%}
            <div class="product__block" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <button type="button" class="link" data-dialog-open="Popup-{{ block.id }}">{{ block.settings.text | default: block.settings.page.title }}</button>
              <dialog id="Popup-{{ block.id }}" class="product-popup">
                <div class="product-popup__box">
                  <button type="button" class="drawer__close product-popup__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
                  <h2 class="h2">{{ block.settings.page.title }}</h2>
                  <div class="rte">{{ block.settings.page.content }}</div>
                </div>
              </dialog>
            </div>

          {%- when 'icon-with-text' -%}
            {%- liquid
              case block.settings.icon_size
                when 'small'
                  assign is = '2.2rem'
                when 'large'
                  assign is = '4rem'
                else
                  assign is = '3rem'
              endcase
            -%}
            <ul class="product__block icon-text{% if block.settings.layout == 'vertical' %} icon-text--vertical{% endif %}" style="{{ spacing }};--is:{{ is }}" role="list" {{ block.shopify_attributes }}>
              {%- for n in (1..3) -%}
                {%- liquid
                  assign kh = 'heading_' | append: n
                  assign kic = 'icon_' | append: n
                  assign kim = 'image_' | append: n
                -%}
                {%- if block.settings[kh] != blank -%}
                  <li>
                    {%- if block.settings[kim] != blank -%}
                      {{ block.settings[kim] | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {% render 'icon-accordion', icon: block.settings[kic] %}
                    {%- endif -%}
                    <span>{{ block.settings[kh] }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'urgency' -%}
            <div class="product__block" style="{{ spacing }}" {{ block.shopify_attributes }}>
              <span class="urgency" style="--acc:var(--c-{{ block.settings.color_scheme }})">{{ block.settings.urgency }}</span>
            </div>

          {%- when 'complementary' -%}
            {%- if recommendations.performed and recommendations.products_count > 0 -%}
              <div class="product__block" {{ block.shopify_attributes }}>
                <h2 class="h4">{{ block.settings.block_heading }}</h2>
                <ul class="grid" style="--cols:2;--cols-m:2">
                  {%- for rp in recommendations.products limit: block.settings.product_list_limit -%}
                    <li>{% render 'card-product', card_product: rp, media_aspect_ratio: block.settings.image_ratio, sizes: '200px' %}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Dados mínimos das variantes para o JS (bem menor que product | json) {%- endcomment -%}
  <script type="application/json" data-product-json>
    {"url":{{ product.url | json }},"options":{{ product.options | json }},"variants":[
      {%- for v in product.variants -%}
        {"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"sku":{{ v.sku | json }}{% if v.featured_media %},"featured_media":{"id":{{ v.featured_media.id }}}{% endif %}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]}
  </script>

  {%- if sticky_block -%}
    {% render 'sticky-atc', product: product, block: sticky_block, form_id: form_id, section: section %}
  {%- endif -%}
</div>

{%- comment -%} Dados estruturados (SEO) {%- endcomment -%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{%- include 'alireviews_aggregateRating_structured_data' -%}

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.main-product.blocks.text.settings.text.default",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        },
        {
          "type": "header",
          "content": "Block margin"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 30,
          "step": 3,
          "unit": "px",
          "label": "Top margin",
          "default": 15
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 30,
          "step": 3,
          "unit": "px",
          "label": "Bottom margin",
          "default": 15
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            }
          ],
          "label": "Title size",
          "default": "h1"
        },
        {
          "type": "select",
          "id": "title_alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ],
          "default": "left",
          "label": "Title alignment"
        },
        {
          "type": "checkbox",
          "id": "uppercase_title",
          "label": "Uppercase title",
          "default": false
        },
        {
          "type": "header",
          "content": "Block margin"
        },
        {
          "type": "range",
          "id": "margin_top",
