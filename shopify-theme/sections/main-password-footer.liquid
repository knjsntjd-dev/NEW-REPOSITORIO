<footer class="color-{{ section.settings.color_scheme }}" style="background:var(--grad,rgb(var(--bg)))">
  <div class="page-width center" style="padding:3rem 1.6rem;font-size:1.3rem">
    {% render 'social-icons' %}
    <p>{{ 'general.password_page.powered_by_shopify_html' | t: shopify: '<a href="https://www.shopify.com" rel="nofollow" target="_blank">Shopify</a>' }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.main-password-footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
