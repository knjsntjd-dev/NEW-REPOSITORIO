{%- liquid
  assign s = section.settings
  assign columns = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign n = columns.size
-%}
<style>
  .ctp .section-header{max-width:56rem;text-align:left;margin:0 0 3.6rem}
  .ctp .section-header h2{margin:0}
  .ctp__sub{margin:1rem 0 0;font-size:1.6rem;line-height:1.5;opacity:.72}
  .ctp__scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .ctp__grid{display:grid;grid-template-columns:minmax(13rem,1fr) repeat({{ n }},minmax(11.5rem,1fr));column-gap:1.6rem;min-width:calc(13rem + {{ n }} * 11.5rem + {{ n }} * 1.6rem)}
  .ctp__cell{padding:1.6rem 0}
  .ctp__label{align-self:center;font-size:1.5rem;font-weight:600;line-height:1.3}
  .ctp__label span{display:inline-block;padding-bottom:.8rem;border-bottom:.2rem solid var(--ctp-accent);}
  .ctp__head{text-align:center;padding-top:0}
  .ctp__img{width:9.6rem;height:9.6rem;margin:0 auto 1.2rem;display:flex;align-items:center;justify-content:center}
  .ctp__img img{max-width:100%;max-height:100%;object-fit:contain}
  .ctp__name{margin:0;font-size:1.7rem;font-weight:700}
  .ctp__price{margin:.8rem 0 0;font-size:2rem;font-weight:700;opacity:.55}
  .ctp__value{text-align:center;align-self:center;font-size:1.6rem;font-weight:600}
  .ctp__cell:not(.ctp__head):not(.ctp__label){border-top:.1rem solid rgba(0,0,0,.08)}
  .ctp__check{color:#4c9a2a}
  .ctp__x{color:#e0a1a1}
  .ctp__check svg,.ctp__x svg{width:2rem;height:2rem}
  .ctp__col--hl{position:relative;background:rgba(var(--ctp-accent-rgb),.07);border-left:.1rem solid rgba(var(--ctp-accent-rgb),.35);border-right:.1rem solid rgba(var(--ctp-accent-rgb),.35)}
  .ctp__col--hl.ctp__head{border-top:.1rem solid rgba(var(--ctp-accent-rgb),.35);border-radius:1.2rem 1.2rem 0 0;padding-top:1.6rem}
  .ctp__col--hl.ctp__cell:not(.ctp__head){border-top-color:rgba(var(--ctp-accent-rgb),.2)}
  .ctp__col--hl.ctp__last{border-bottom:.1rem solid rgba(var(--ctp-accent-rgb),.35);border-radius:0 0 1.2rem 1.2rem}
  .ctp__col--hl .ctp__name,.ctp__col--hl .ctp__price{color:var(--ctp-accent)}
  .ctp__col--hl .ctp__x{color:#e0a1a1}
</style>

<div {% render 'section-style', s: s, extra: 'ctp' %} style="--ctp-accent:{{ s.accent_color }};--ctp-accent-rgb:{{ s.accent_color | color_extract: 'red' }},{{ s.accent_color | color_extract: 'green' }},{{ s.accent_color | color_extract: 'blue' }}">
  <div class="page-width">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="section-header">
        {%- if s.heading != blank -%}<h2 class="{{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="ctp__sub">{{ s.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if n > 0 -%}
      <div class="ctp__scroll">
        <div class="ctp__grid" role="table" aria-label="{{ s.heading | escape }}">
          <div class="ctp__cell ctp__head" role="presentation"></div>
          {%- for col in columns -%}
            {%- assign cb = col.settings -%}
            <div class="ctp__cell ctp__head{% if cb.highlight %} ctp__col--hl{% endif %}" role="columnheader" {{ col.shopify_attributes }}>
              {%- if cb.image != blank -%}
                <div class="ctp__img">{{ cb.image | image_url: width: 200 | image_tag: widths: '100,150,200', sizes: '96px', loading: 'lazy', alt: cb.name }}</div>
              {%- endif -%}
              {%- if cb.name != blank -%}<p class="ctp__name">{{ cb.name | escape }}</p>{%- endif -%}
              {%- if cb.price != blank -%}<p class="ctp__price">{{ cb.price | escape }}</p>{%- endif -%}
            </div>
          {%- endfor -%}

          {%- for row in rows -%}
            {%- assign rb = row.settings -%}
            <div class="ctp__cell ctp__label" role="rowheader" {{ row.shopify_attributes }}><span>{{ rb.label | escape }}</span></div>
            {%- for col in columns -%}
              {%- liquid
                assign idx = forloop.index
                assign is_last = false
                if forloop.parentloop.last
                  assign is_last = true
                endif
                assign key = 'value_' | append: idx
                assign ckey = 'check_' | append: idx
                assign val = rb[key]
                assign checked = rb[ckey]
              -%}
              <div class="ctp__cell ctp__value{% if col.settings.highlight %} ctp__col--hl{% endif %}{% if is_last %} ctp__last{% endif %}" role="cell">
                {%- if rb.style == 'check' -%}
                  {%- if checked -%}
                    <span class="ctp__check">{% render 'icon', name: 'check', stroke: 3 %}</span>
                  {%- else -%}
                    <span class="ctp__x">{% render 'icon', name: 'x', stroke: 3 %}</span>
                  {%- endif -%}
                {%- else -%}
                  {{ val | escape }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabela comparativa",
  "tag": "section",
  "class": "section-comparison-table-pro",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Como podemos comparar?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamanho do título",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Descreva por que o seu produto é melhor que os outros.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque (coluna nossa)",
      "default": "#5B8A3A"
    },
    {
      "type": "header",
      "content": "Cores e espaçamento"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "custom_colors_background",
      "label": "Cor de fundo (Custom)",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "custom_gradient_background",
      "label": "Gradiente de fundo (Custom)"
    },
    {
      "type": "color",
      "id": "custom_colors_text",
      "label": "Cor do texto (Custom)",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Coluna (produto)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome",
          "default": "Nosso produto"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Preço",
          "default": "$ 59,99"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Destacar esta coluna (nosso produto)",
          "default": false
        }
      ]
    },
    {
      "type": "row",
      "name": "Linha de comparação",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nome do atributo",
          "default": "Atributo"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Tipo de valor",
          "options": [
            { "value": "check", "label": "Certo / Errado" },
            { "value": "text", "label": "Texto" }
          ],
          "default": "check"
        },
        { "type": "header", "content": "Valores por coluna (na ordem das colunas)" },
        { "type": "checkbox", "id": "check_1", "label": "Coluna 1 — certo", "default": true },
        { "type": "text", "id": "value_1", "label": "Coluna 1 — texto" },
        { "type": "checkbox", "id": "check_2", "label": "Coluna 2 — certo", "default": false },
        { "type": "text", "id": "value_2", "label": "Coluna 2 — texto" },
        { "type": "checkbox", "id": "check_3", "label": "Coluna 3 — certo", "default": false },
        { "type": "text", "id": "value_3", "label": "Coluna 3 — texto" },
        { "type": "checkbox", "id": "check_4", "label": "Coluna 4 — certo", "default": false },
        { "type": "text", "id": "value_4", "label": "Coluna 4 — texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabela comparativa",
      "blocks": [
        { "type": "column", "settings": { "name": "Pro Eletrólito", "price": "$ 59,99", "highlight": true } },
        { "type": "column", "settings": { "name": "Outro 1", "price": "$$$" } },
        { "type": "column", "settings": { "name": "Outros 2", "price": "$" } },
        { "type": "row", "settings": { "label": "Comparação de preços", "style": "text", "value_1": "$ 59,99", "value_2": "$$$", "value_3": "$" } },
        { "type": "row", "settings": { "label": "Sem açúcar", "style": "check", "check_1": true, "check_2": true, "check_3": false } },
        { "type": "row", "settings": { "label": "Sabores refrescantes", "style": "check", "check_1": true, "check_2": false, "check_3": false } },
        { "type": "row", "settings": { "label": "Testado por laboratórios terceirizados", "style": "check", "check_1": true, "check_2": false, "check_3": false } },
        { "type": "row", "settings": { "label": "100% rastreável até a origem", "style": "check", "check_1": true, "check_2": false, "check_3": false } }
      ]
    }
  ]
}
{% endschema %}
