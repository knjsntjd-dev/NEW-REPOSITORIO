{%- liquid
  assign s = section.settings
  assign pos = s.desktop_content_position | split: '-'
  case pos[0]
    when 'top'
      assign v = 'flex-start'
    when 'bottom'
      assign v = 'flex-end'
    else
      assign v = 'center'
  endcase
  case pos[1]
    when 'left'
      assign h = 'flex-start'
    when 'right'
      assign h = 'flex-end'
    else
      assign h = 'center'
  endcase
  assign bg = false
  if s.show_background_image and s.image != blank
    assign bg = true
  endif
  assign height = s.image_height | replace: 'adapt-image', 'adapt'
-%}
<div class="banner banner--{% if bg %}{{ height }}{% else %}small{% endif %}{% if s.show_text_below %} banner--below{% endif %} color-{{ s.color_scheme }}" style="--overlay:{{ s.image_overlay_opacity | divided_by: 100.0 }};--v:{{ v }};--h:{{ h }};--align:{{ s.desktop_content_alignment }};--align-m:{{ s.mobile_content_alignment }}">
  {%- if bg -%}
    <div class="banner__media"><div{% if height == 'adapt' %} style="aspect-ratio:{{ s.image.aspect_ratio }}"{% endif %}>{{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '375,750,1100,1500,2000,2400', sizes: '100vw' }}</div></div>
  {%- endif -%}
  <div class="banner__content">
    <div class="banner__box{% if s.show_text_box %} banner__box--boxed{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}<h2 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'paragraph' -%}<div class="rte{% if block.settings.text_style == 'subtitle' %} subtitle{% endif %}" style="margin-bottom:2rem" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'email_form' -%}<div {{ block.shopify_attributes }}>{% render 'newsletter-form', id: section.id %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.email-signup-banner.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.email-signup-banner.settings.paragraph.content"
