{%- liquid
  assign s = section.settings
  case s.desktop_image_width
    when 'small'
      assign iw = '0.5fr'
    when 'large'
      assign iw = '1.5fr'
    else
      assign iw = '1fr'
  endcase
  case s.desktop_content_position
    when 'top'
      assign v = 'flex-start'
    when 'bottom'
      assign v = 'flex-end'
    else
      assign v = 'center'
  endcase
  assign items = s.desktop_content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  assign items_m = s.mobile_content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
-%}
<div class="section color-{{ s.section_color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px">
  <div class="page-width stack">
    {%- for block in section.blocks -%}
      {%- liquid
        assign text_first = false
        case s.image_layout
          when 'alternate-right'
            assign m = forloop.index | modulo: 2
            if m == 1
              assign text_first = true
            endif
          when 'alternate-left'
            assign m = forloop.index | modulo: 2
            if m == 0
              assign text_first = true
            endif
          when 'align-right'
            assign text_first = true
        endcase
      -%}
      <div class="iwt iwt--{{ s.image_height }}{% if text_first %} iwt--text-first{% endif %}" style="--img-w:{{ iw }};--v:{{ v }};--align:{{ s.desktop_content_alignment }};--align-m:{{ s.mobile_content_alignment }};--items:{{ items }};--items-m:{{ items_m }}" {{ block.shopify_attributes }}>
        <div class="iwt__media"{% if s.image_height == 'adapt' and block.settings.image != blank %} style="aspect-ratio:{{ block.settings.image.aspect_ratio }}"{% endif %}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '375,550,750,1000,1500', sizes: '(min-width: 750px) 50vw, 100vw' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <div class="iwt__content color-{{ s.row_color_scheme }}">
          {%- if block.settings.caption != blank -%}<p class="caption-with-letter-spacing">{{ block.settings.caption | escape }}</p>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h2 class="{{ s.heading_size }}">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte{% if s.text_style == 'subtitle' %} subtitle{% endif %}">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.button_label != blank -%}<a class="btn{% if s.button_style == 'secondary' %} btn--secondary{% endif %}" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multirow.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
