{%- assign s = section.settings -%}{%- assign mf = product.metafields.rlp -%}
<div class="rlp">
{%- assign im1 = mf.img_1 | default: s.img_1 -%}{%- assign im2 = mf.img_2 | default: s.img_2 -%}{%- assign im3 = mf.img_3 | default: s.img_3 -%}
{%- if im1 != blank or im2 != blank or im3 != blank -%}
<section class="rlp-pillars">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      {%- assign eb = mf.ben_eyebrow | default: s.ben_eyebrow -%}{%- if eb != blank -%}<span class="rlp-eyebrow">{{ eb }}</span>{%- endif -%}
      {%- assign tt = mf.ben_titulo | default: s.ben_titulo -%}{%- if tt != blank -%}<h2>{{ tt }}</h2>{%- endif -%}
      {%- assign tx = mf.ben_texto | default: s.ben_texto -%}{%- if tx != blank -%}<p class="rlp-lead">{{ tx }}</p>{%- endif -%}
    </div>
    <div class="rlp-p-grid">
      {%- for i in (1..3) -%}
        {%- case i -%}{%- when 1 -%}{%- assign im = im1 -%}{%- when 2 -%}{%- assign im = im2 -%}{%- else -%}{%- assign im = im3 -%}{%- endcase -%}
        {%- if im != blank -%}
        {%- assign ar = im.value.preview_image.aspect_ratio | default: im.aspect_ratio | default: im.preview_image.aspect_ratio | default: 1 -%}
        {%- capture kt -%}legenda_{{ i }}_titulo{%- endcapture -%}{%- capture kx -%}legenda_{{ i }}_texto{%- endcapture -%}
        {%- assign lt = mf[kt] | default: s[kt] -%}{%- assign lx = mf[kx] | default: s[kx] -%}
      <article class="rlp-p-card rlp-rv">
        <figure class="rlp-shot" style="margin:0;aspect-ratio:{{ ar }}">{{ im | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: lt }}</figure>
        {%- if lt != blank -%}<h3>{{ lt }}</h3>{%- endif -%}{%- if lx != blank -%}<p>{{ lx }}</p>{%- endif -%}
      </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="rlp-pillars"><div class="rlp-wrap"><p style="text-align:center;padding:24px;border:1.5px dashed rgba(0,0,0,.2)">RLP · Benefícios em fotos — escolha pelo menos uma imagem nas configurações desta seção.</p></div></section>
{%- endif -%}
</div>

{% schema %}
{
  "name": "RLP · Benefícios em fotos",
  "tag": "section",
  "class": "rlp-sec",
  "settings": [
    { "type": "paragraph", "content": "Até 3 fotos com legenda. A seção só aparece quando há pelo menos uma imagem. Deixe um texto vazio para escondê-lo." },
    { "type": "text", "id": "ben_eyebrow", "label": "Texto pequeno acima", "default": "Por que funciona" },
    { "type": "text", "id": "ben_titulo", "label": "Título", "default": "Título da seção de benefícios" },
    { "type": "textarea", "id": "ben_texto", "label": "Texto", "default": "Uma frase sobre por que o produto funciona." },
    { "type": "header", "content": "Foto 1" },
    { "type": "image_picker", "id": "img_1", "label": "Imagem" },
    { "type": "text", "id": "legenda_1_titulo", "label": "Título" },
    { "type": "textarea", "id": "legenda_1_texto", "label": "Texto" },
    { "type": "header", "content": "Foto 2" },
    { "type": "image_picker", "id": "img_2", "label": "Imagem" },
    { "type": "text", "id": "legenda_2_titulo", "label": "Título" },
    { "type": "textarea", "id": "legenda_2_texto", "label": "Texto" },
    { "type": "header", "content": "Foto 3" },
    { "type": "image_picker", "id": "img_3", "label": "Imagem" },
    { "type": "text", "id": "legenda_3_titulo", "label": "Título" },
    { "type": "textarea", "id": "legenda_3_texto", "label": "Texto" }
  ],
  "presets": [
    { "name": "RLP · Benefícios em fotos" }
  ]
}
{% endschema %}
