<div class="rlp">
<section class="rlp-compare">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">{{ product.metafields.rlp.cmp_eyebrow | default: 'Nós contra eles' }}</span>
      <h2>{{ product.metafields.rlp.cmp_titulo | default: 'Porque escolher o nosso produto' }}</h2>
      <p class="rlp-lead">{{ product.metafields.rlp.cmp_texto | default: 'O problema dos produtos comuns numa frase. Como o seu produto resolve.' }}</p>
    </div>
    <div class="rlp-compare-wrap rlp-rv">
      <table class="rlp-compare-table">
        <colgroup><col class="rlp-lbl"><col class="rlp-hl-col"><col class="rlp-oth"><col class="rlp-oth"></colgroup>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="rlp-hl"><span class="rlp-compare-brand"><b>{{ product.metafields.rlp.cmp_nosso | default: 'PRODUTO' }}</b><span>{{ product.metafields.rlp.cmp_marca | default: 'USE RODRIGUES' }}</span></span></th>
            <th scope="col">{{ product.metafields.rlp.cmp_col2 | default: 'Comum' }}</th>
            <th scope="col">{{ product.metafields.rlp.cmp_col3 | default: 'Barato' }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ product.metafields.rlp.criterio_estrelas | default: 'Qualidade geral' }}</th>
            <td class="rlp-hl"><span class="rlp-compare-stars" aria-label="5 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span></span></td>
            <td><span class="rlp-compare-stars" aria-label="3 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span></span></td>
            <td><span class="rlp-compare-stars" aria-label="2 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span></span></td>
          </tr>
          {%- assign crit1 = product.metafields.rlp.criterio_1 | default: 'Critério 1' -%}
          {%- if crit1 != blank -%}
          <tr>
            <th scope="row">{{ crit1 }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
          {%- endif -%}
          {%- assign crit2 = product.metafields.rlp.criterio_2 | default: 'Critério 2' -%}
          {%- if crit2 != blank -%}
          <tr>
            <th scope="row">{{ crit2 }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
          {%- endif -%}
          {%- assign crit3 = product.metafields.rlp.criterio_3 | default: 'Critério 3' -%}
          {%- if crit3 != blank -%}
          <tr>
            <th scope="row">{{ crit3 }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
          {%- endif -%}
          {%- assign crit4 = product.metafields.rlp.criterio_4 | default: 'Critério 4' -%}
          {%- if crit4 != blank -%}
          <tr>
            <th scope="row">{{ crit4 }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
          {%- endif -%}
          {%- assign crit5 = product.metafields.rlp.criterio_5 | default: 'Critério 5' -%}
          {%- if crit5 != blank -%}
          <tr>
            <th scope="row">{{ crit5 }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{%- assign im1 = product.metafields.rlp.img_1 -%}{%- assign im2 = product.metafields.rlp.img_2 -%}{%- assign im3 = product.metafields.rlp.img_3 -%}
{%- if im1 != blank or im2 != blank or im3 != blank -%}
<section class="rlp-pillars">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">{{ product.metafields.rlp.ben_eyebrow | default: 'Porque funciona' }}</span>
      <h2>{{ product.metafields.rlp.ben_titulo | default: 'Título da secção de benefícios' }}</h2>
      <p class="rlp-lead">{{ product.metafields.rlp.ben_texto | default: 'Uma frase sobre porque o produto funciona.' }}</p>
    </div>
    <div class="rlp-p-grid">
      {%- if im1 != blank -%}
      <article class="rlp-p-card rlp-rv">
        <figure class="rlp-shot" style="margin:0;aspect-ratio:{{ im1.aspect_ratio }}">{{ im1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: im1.alt }}</figure>
      </article>
      {%- endif -%}
      {%- if im2 != blank -%}
      <article class="rlp-p-card rlp-rv">
        <figure class="rlp-shot" style="margin:0;aspect-ratio:{{ im2.aspect_ratio }}">{{ im2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: im2.alt }}</figure>
      </article>
      {%- endif -%}
      {%- if im3 != blank -%}
      <article class="rlp-p-card rlp-rv">
        <figure class="rlp-shot" style="margin:0;aspect-ratio:{{ im3.aspect_ratio }}">{{ im3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: im3.alt }}</figure>
      </article>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
</div>

{% schema %}
{
  "name": "RLP · Comparação",
  "tag": "section",
  "class": "rlp-sec",
  "settings": [
    {
      "type": "paragraph",
      "content": "Os textos desta secção vêm do produto (Metafields → rlp), não daqui — assim servem para qualquer produto que use este modelo. Edite em Produtos → [o produto] → Metafields, ou peça para os preencherem por si."
    }
  ],
  "presets": [
    {
      "name": "RLP · Comparação"
    }
  ]
}
{% endschema %}
