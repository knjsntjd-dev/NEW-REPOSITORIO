      "type": "text",
      "id": "cmp_titulo",
      "label": "Título",
      "default": "Porque escolher o nosso produto"
    },
    {
      "type": "textarea",
      "id": "cmp_texto",
      "label": "Texto",
      "default": "O problema dos produtos comuns numa frase. Como o seu produto resolve."
    },
    {
      "type": "text",
      "id": "cmp_nosso",
      "label": "Coluna em destaque — nome",
      "default": "PRODUTO"
    },
    {
      "type": "text",
      "id": "cmp_marca",
      "label": "Coluna em destaque — marca",
      "default": "USE RODRIGUES"
    },
    {
      "type": "text",
      "id": "cmp_col2",
      "label": "Coluna 2 (concorrente)",
      "default": "Comum"
    },
    {
      "type": "text",
      "id": "cmp_col3",
      "label": "Coluna 3 (concorrente)",
      "default": "Barato"
    },
    {
      "type": "text",
      "id": "criterio_estrelas",
      "label": "Linha com estrelas",
      "default": "Qualidade geral"
    },
    {
      "type": "text",
      "id": "criterio_1",
      "label": "Critério 1 (vazio = esconde)",
      "default": "Critério 1"
    },
    {
      "type": "text",
      "id": "criterio_2",
      "label": "Critério 2 (vazio = esconde)",
      "default": "Critério 2"
    },
    {
      "type": "text",
      "id": "criterio_3",
      "label": "Critério 3 (vazio = esconde)",
      "default": "Critério 3"
    },
    {
      "type": "text",
      "id": "criterio_4",
      "label": "Critério 4 (vazio = esconde)",
      "default": "Critério 4"
    },
    {
      "type": "text",
      "id": "criterio_5",
      "label": "Critério 5 (vazio = esconde)",
      "default": "Critério 5"
    },
    {
      "type": "header",
      "content": "Benefícios (artes)"
    },
    {
      "type": "text",
      "id": "ben_eyebrow",
      "label": "Etiqueta",
      "default": "Porque funciona"
    },
    {
      "type": "text",
      "id": "ben_titulo",
      "label": "Título",
      "default": "Título da secção de benefícios"
    },
    {
      "type": "textarea",
      "id": "ben_texto",
      "label": "Texto",
