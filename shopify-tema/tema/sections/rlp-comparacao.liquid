<div class="rlp">
<section class="rlp-compare">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">{{ section.settings.cmp_eyebrow }}</span>
      <h2>{{ section.settings.cmp_titulo }}</h2>
      <p class="rlp-lead">{{ section.settings.cmp_texto }}</p>
    </div>
    <div class="rlp-compare-wrap rlp-rv">
      <table class="rlp-compare-table">
        <colgroup><col class="rlp-lbl"><col class="rlp-hl-col"><col class="rlp-oth"><col class="rlp-oth"></colgroup>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="rlp-hl"><span class="rlp-compare-brand"><b>{{ section.settings.cmp_nosso }}</b><span>{{ section.settings.cmp_marca }}</span></span></th>
            <th scope="col">{{ section.settings.cmp_col2 }}</th>
            <th scope="col">{{ section.settings.cmp_col3 }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ section.settings.criterio_estrelas }}</th>
            <td class="rlp-hl"><span class="rlp-compare-stars" aria-label="5 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span></span></td>
            <td><span class="rlp-compare-stars" aria-label="3 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span></span></td>
            <td><span class="rlp-compare-stars" aria-label="2 de 5 estrelas"><span class="rlp-on">★</span><span class="rlp-on">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span><span class="rlp-off">★</span></span></td>
          </tr>
{%- for i in (1..5) -%}{%- capture k -%}criterio_{{ i }}{%- endcapture -%}{%- if section.settings[k] != blank -%}
          <tr>
            <th scope="row">{{ section.settings[k] }}</th>
            <td class="rlp-hl"><span class="rlp-compare-badge rlp-ok" aria-label="Sim">✓</span></td>
            <td><span class="rlp-compare-badge rlp-mid" aria-label="Parcial">–</span></td>
            <td><span class="rlp-compare-badge rlp-no" aria-label="Não">✕</span></td>
          </tr>
{%- endif -%}{%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{%- if section.settings.img_1 != blank or section.settings.img_2 != blank or section.settings.img_3 != blank -%}
<section class="rlp-pillars">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">{{ section.settings.ben_eyebrow }}</span>
      <h2>{{ section.settings.ben_titulo }}</h2>
      <p class="rlp-lead">{{ section.settings.ben_texto }}</p>
    </div>
    <div class="rlp-p-grid">
      {%- for i in (1..3) -%}{%- capture k -%}img_{{ i }}{%- endcapture -%}{%- assign im = section.settings[k] -%}
      {%- if im != blank -%}
      <article class="rlp-p-card rlp-rv">
        <figure class="rlp-shot" style="margin:0;aspect-ratio:{{ im.aspect_ratio }}">{{ im | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: im.alt }}</figure>
      </article>
      {%- endif -%}{%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
</div>

{% schema %}
{
  "name": "RLP · Comparação",
  "tag": "section",
  "class": "rlp-sec",
  "settings": [
    {
      "type": "header",
      "content": "Comparação"
    },
    {
      "type": "text",
      "id": "cmp_eyebrow",
      "label": "Etiqueta",
      "default": "Nós contra eles"
