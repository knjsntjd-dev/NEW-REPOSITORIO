    {
      "type": "image_picker",
      "id": "img_1",
      "label": "Arte 1"
    },
    {
      "type": "image_picker",
      "id": "img_2",
      "label": "Arte 2"
    },
    {
      "type": "image_picker",
      "id": "img_3",
      "label": "Arte 3"
    }
  ],
  "presets": [
    {
      "name": "RLP · Comparação"
    }
  ]
}
