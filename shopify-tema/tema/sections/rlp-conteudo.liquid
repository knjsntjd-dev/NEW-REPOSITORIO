{%- liquid
  assign p = product
  assign v0 = p.selected_or_first_available_variant
-%}
<div class="rlp">
{%- if section.settings.mostrar_tabela and section.settings.tabela_medidas != blank -%}
<section class="rlp-sizing">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">Guia de tamanhos</span>
      <h2>{{ section.settings.tam_titulo }}</h2>
      <p class="rlp-lead">{{ section.settings.tam_texto }}</p>
    </div>
    <div class="rlp-sizing-grid rlp-rv">
      <div class="rlp-tbl-wrap">
        <table>
          <thead><tr><th>Tamanho</th><th>{{ section.settings.medida_nome }}</th></tr></thead>
          <tbody>{%- assign linhas = section.settings.tabela_medidas | newline_to_br | split: '<br />' -%}
{%- for l in linhas -%}{%- assign c = l | strip | split: '|' -%}{%- if c.size > 1 -%}
<tr><td>{{ c[0] | strip }}</td><td class="rlp-num">{{ c[1] | strip }}</td></tr>
{%- endif -%}{%- endfor -%}</tbody>
        </table>
      </div>
      <p class="rlp-tbl-note">{{ section.settings.tam_nota }}</p>
    </div>
  </div>
</section>
{%- endif -%}

{%- if section.settings.dep_1_texto != blank -%}
<section class="rlp-reviews">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow rlp-num">{{ section.settings.dep_eyebrow }}</span>
      <h2>{{ section.settings.dep_titulo }}</h2>
    </div>
    <div class="rlp-r-grid rlp-rv">
      {%- for i in (1..3) -%}
      {%- capture kt -%}dep_{{ i }}_texto{%- endcapture -%}{%- capture kn -%}dep_{{ i }}_nome{%- endcapture -%}
      {%- if section.settings[kt] != blank -%}
      <article class="rlp-r-card">
        <span class="rlp-stars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg></span>
        <q>{{ section.settings[kt] }}</q>
        <p class="rlp-r-who"><b>{{ section.settings[kn] }}</b> · Compra verificada</p>
      </article>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<section class="rlp-final">
  <div class="rlp-wrap">
    <div class="rlp-final-box rlp-rv">
      <span class="rlp-eyebrow">{{ section.settings.fim_eyebrow }}</span>
      <h2>{{ p.title }}</h2>
      <p class="rlp-lead" style="margin-inline:auto">{{ section.settings.fim_texto }}</p>
      <div class="rlp-price-row">
        <span class="rlp-price rlp-num" data-final-preco>{{ v0.price | money }}</span>
        <span class="rlp-price-old rlp-num" data-final-antigo>{{ v0.compare_at_price | money }}</span>
      </div>
      <p class="rlp-tax-note" style="margin-bottom:6px">{{ section.settings.fim_nota_preco }}</p>
      <a class="rlp-cta" href="#comprar" data-buy id="ctaFinal">Comprar agora — {{ v0.price | money }}</a>
      <span class="rlp-seal">
        <svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        {{ section.settings.fim_selo }}
      </span>
    </div>
  </div>
</section>

<section class="rlp-faq">
  <div class="rlp-wrap">
    <div class="rlp-faq-list rlp-rv">
      {%- for i in (1..6) -%}
      {%- capture kp -%}faq_{{ i }}_pergunta{%- endcapture -%}{%- capture kr -%}faq_{{ i }}_resposta{%- endcapture -%}
      {%- if section.settings[kp] != blank -%}
      <details>
        <summary>{{ section.settings[kp] }}</summary>
        <div class="rlp-faq-body">{{ section.settings[kr] }}</div>
      </details>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "RLP · Tamanhos e FAQ",
  "tag": "section",
  "class": "rlp-sec",
  "settings": [
    {
      "type": "header",
      "content": "Tabela de tamanhos"
    },
    {
      "type": "checkbox",
      "id": "mostrar_tabela",
      "label": "Mostrar secção de tamanhos",
      "default": true
    },
    {
      "type": "text",
      "id": "tam_titulo",
      "label": "Título",
      "default": "Encontre o seu tamanho"
    },
    {
      "type": "textarea",
      "id": "tam_texto",
      "label": "Como medir",
      "default": "Como medir para escolher o tamanho. Em dúvida entre dois tamanhos, escolha o maior."
    },
    {
      "type": "text",
      "id": "medida_nome",
      "label": "Nome da medida (coluna)",
      "default": "Cintura"
    },
    {
      "type": "textarea",
      "id": "tabela_medidas",
      "label": "Tabela: Tamanho | medida (uma por linha)",
      "default": "S | 62 – 68 cm\nM | 68 – 74 cm\nL | 74 – 80 cm\nXL | 80 – 86 cm\nXXL | 86 – 92 cm\n3XL | 92 – 98 cm"
    },
    {
      "type": "text",
      "id": "tam_nota",
      "label": "Nota abaixo da tabela",
      "default": "Se o tamanho não servir, trocamos nos primeiros 30 dias."
    },
    {
      "type": "header",
      "content": "Depoimentos (só avaliações reais)"
    },
    {
      "type": "text",
      "id": "dep_eyebrow",
      "label": "Etiqueta",
      "default": "4,8 / 5 · clientes verificados"
    },
    {
      "type": "text",
      "id": "dep_titulo",
      "label": "Título",
      "default": "O que diz quem já usa"
    },
    {
      "type": "textarea",
      "id": "dep_1_texto",
      "label": "Depoimento 1",
      "default": ""
    },
    {
      "type": "text",
      "id": "dep_1_nome",
      "label": "Depoimento 1 — nome e cidade",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "dep_2_texto",
      "label": "Depoimento 2",
      "default": ""
    },
    {
      "type": "text",
      "id": "dep_2_nome",
      "label": "Depoimento 2 — nome e cidade",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "dep_3_texto",
      "label": "Depoimento 3",
      "default": ""
    },
    {
      "type": "text",
      "id": "dep_3_nome",
      "label": "Depoimento 3 — nome e cidade",
      "default": ""
    },
    {
      "type": "header",
      "content": "Chamada final"
    },
    {
      "type": "text",
      "id": "fim_eyebrow",
      "label": "Etiqueta",
      "default": "Oferta por tempo limitado"
    },
    {
      "type": "textarea",
      "id": "fim_texto",
      "label": "Texto",
      "default": "Escolha o tamanho, receba em casa e experimente sem risco durante 30 dias."
    },
    {
      "type": "text",
      "id": "fim_nota_preco",
      "label": "Linha abaixo do preço",
      "default": "IVA incluído · Frete grátis em todas as encomendas"
    },
    {
      "type": "text",
      "id": "fim_selo",
      "label": "Selo",
      "default": "Garantia de satisfação · 30 dias"
    },
    {
      "type": "header",
      "content": "Perguntas frequentes (vazio = esconde)"
    },
    {
      "type": "text",
      "id": "faq_1_pergunta",
      "label": "Pergunta 1",
      "default": "Qual tamanho devo escolher?"
    },
    {
      "type": "textarea",
      "id": "faq_1_resposta",
      "label": "Resposta 1",
      "default": "Veja o guia de medidas acima. Em dúvida entre dois tamanhos, escolha o maior."
    },
    {
      "type": "text",
      "id": "faq_2_pergunta",
      "label": "Pergunta 2",
      "default": "Quanto tempo demora a entrega?"
    },
    {
      "type": "textarea",
      "id": "faq_2_resposta",
      "label": "Resposta 2",
      "default": "Enviamos em 24 horas úteis. A entrega demora normalmente 3 a 6 dias úteis e recebe o código de rastreio por e-mail."
    },
    {
      "type": "text",
      "id": "faq_3_pergunta",
      "label": "Pergunta 3",
      "default": "Como funciona o desconto de quantidade?"
    },
    {
      "type": "textarea",
      "id": "faq_3_resposta",
      "label": "Resposta 3",
      "default": "Ao escolher 2 peças, o desconto de 10% aplica-se ao total; com 3 peças, 15%. O envio é grátis em qualquer encomenda."
    },
    {
      "type": "text",
      "id": "faq_4_pergunta",
      "label": "Pergunta 4",
      "default": "E se não servir?"
    },
    {
      "type": "textarea",
      "id": "faq_4_resposta",
      "label": "Resposta 4",
      "default": "Tem 30 dias para pedir troca de tamanho ou devolução. Basta responder ao e-mail da encomenda — tratamos do resto."
    },
    {
      "type": "text",
      "id": "faq_5_pergunta",
      "label": "Pergunta 5",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "faq_5_resposta",
      "label": "Resposta 5",
      "default": ""
    },
    {
      "type": "text",
      "id": "faq_6_pergunta",
      "label": "Pergunta 6",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "faq_6_resposta",
      "label": "Resposta 6",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "RLP · Tamanhos e FAQ"
    }
  ]
}
{% endschema %}
