{%- liquid
  assign p = product
  assign v0 = p.selected_or_first_available_variant
-%}
<div class="rlp">
{%- assign tabela_txt = product.metafields.rlp.tabela_medidas | default: 'S | 62 – 68 cm
M | 68 – 74 cm
L | 74 – 80 cm
XL | 80 – 86 cm
XXL | 86 – 92 cm
3XL | 92 – 98 cm' -%}
{%- assign esconder_tam = product.metafields.rlp.esconder_tamanhos -%}
{%- if tabela_txt != blank and esconder_tam != 'sim' -%}
<section class="rlp-sizing">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow">Guia de tamanhos</span>
      <h2>{{ product.metafields.rlp.tam_titulo | default: 'Encontre o seu tamanho' }}</h2>
      <p class="rlp-lead">{{ product.metafields.rlp.tam_texto | default: 'Como medir para escolher o tamanho. Em dúvida entre dois tamanhos, escolha o maior.' }}</p>
    </div>
    <div class="rlp-sizing-grid rlp-rv">
      <div class="rlp-tbl-wrap">
        <table>
          <thead><tr><th>Tamanho</th><th>{{ product.metafields.rlp.medida_nome | default: 'Cintura' }}</th></tr></thead>
          <tbody>{%- assign linhas = product.metafields.rlp.tabela_medidas | default: 'S | 62 – 68 cm
M | 68 – 74 cm
L | 74 – 80 cm
XL | 80 – 86 cm
XXL | 86 – 92 cm
3XL | 92 – 98 cm' | newline_to_br | split: '<br />' -%}{%- for l in linhas -%}{%- assign c = l | strip | split: '|' -%}{%- if c.size > 1 -%}<tr><td>{{ c[0] | strip }}</td><td class="rlp-num">{{ c[1] | strip }}</td></tr>{%- endif -%}{%- endfor -%}</tbody>
        </table>
      </div>
      <p class="rlp-tbl-note">{{ product.metafields.rlp.tam_nota | default: 'Se o tamanho não servir, trocamos nos primeiros 30 dias.' }}</p>
    </div>
  </div>
</section>
{%- endif -%}

{%- assign dep1 = product.metafields.rlp.dep_1_texto -%}
{%- if dep1 != blank -%}
<section class="rlp-reviews">
  <div class="rlp-wrap">
    <div class="rlp-sec-head rlp-rv">
      <span class="rlp-eyebrow rlp-num">{{ product.metafields.rlp.dep_eyebrow | default: '4,8 / 5 · clientes verificados' }}</span>
      <h2>{{ product.metafields.rlp.dep_titulo | default: 'O que diz quem já usa' }}</h2>
    </div>
    <div class="rlp-r-grid rlp-rv">
      {%- for i in (1..3) -%}
      {%- capture kt -%}dep_{{ i }}_texto{%- endcapture -%}{%- capture kn -%}dep_{{ i }}_nome{%- endcapture -%}
      {%- assign dt = product.metafields.rlp[kt] -%}{%- assign dn = product.metafields.rlp[kn] -%}
      {%- if dt != blank -%}
      <article class="rlp-r-card">
        <span class="rlp-stars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .7-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.7z"/></svg></span>
        <q>{{ dt }}</q>
        <p class="rlp-r-who"><b>{{ dn }}</b> · Compra verificada</p>
      </article>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<section class="rlp-final">
  <div class="rlp-wrap">
    <div class="rlp-final-box rlp-rv">
      <span class="rlp-eyebrow">{{ product.metafields.rlp.fim_eyebrow | default: 'Oferta por tempo limitado' }}</span>
      <h2>{{ p.title }}</h2>
      <p class="rlp-lead" style="margin-inline:auto">{{ product.metafields.rlp.fim_texto | default: 'Escolha o tamanho, receba em casa e experimente sem risco durante 30 dias.' }}</p>
      <div class="rlp-price-row">
        <span class="rlp-price rlp-num" data-final-preco>{{ v0.price | money }}</span>
        <span class="rlp-price-old rlp-num" data-final-antigo>{{ v0.compare_at_price | money }}</span>
      </div>
      <p class="rlp-tax-note" style="margin-bottom:6px">{{ product.metafields.rlp.fim_nota_preco | default: 'IVA incluído · Frete grátis em todas as encomendas' }}</p>
      <a class="rlp-cta" href="#comprar" data-buy id="ctaFinal">Comprar agora — {{ v0.price | money }}</a>
      <span class="rlp-seal">
        <svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        {{ product.metafields.rlp.fim_selo | default: 'Garantia de satisfação · 30 dias' }}
      </span>
    </div>
  </div>
</section>

<section class="rlp-faq">
  <div class="rlp-wrap">
    <div class="rlp-faq-list rlp-rv">
      {%- assign faqp1 = product.metafields.rlp.faq_1_pergunta | default: "Qual tamanho devo escolher?" -%}
      {%- assign faqr1 = product.metafields.rlp.faq_1_resposta | default: "Veja o guia de medidas acima. Em dúvida entre dois tamanhos, escolha o maior." -%}
      {%- if faqp1 != blank -%}
      <details>
        <summary>{{ faqp1 }}</summary>
        <div class="rlp-faq-body">{{ faqr1 }}</div>
      </details>
      {%- endif -%}
      {%- assign faqp2 = product.metafields.rlp.faq_2_pergunta | default: "Quanto tempo demora a entrega?" -%}
      {%- assign faqr2 = product.metafields.rlp.faq_2_resposta | default: "Enviamos em 24 horas úteis. A entrega demora normalmente 3 a 6 dias úteis e recebe o código de rastreio por e-mail." -%}
      {%- if faqp2 != blank -%}
      <details>
        <summary>{{ faqp2 }}</summary>
        <div class="rlp-faq-body">{{ faqr2 }}</div>
      </details>
      {%- endif -%}
      {%- assign faqp3 = product.metafields.rlp.faq_3_pergunta | default: "Como funciona o desconto de quantidade?" -%}
      {%- assign faqr3 = product.metafields.rlp.faq_3_resposta | default: "Ao escolher 2 peças, o desconto de 10% aplica-se ao total; com 3 peças, 15%. O envio é grátis em qualquer encomenda." -%}
      {%- if faqp3 != blank -%}
      <details>
        <summary>{{ faqp3 }}</summary>
        <div class="rlp-faq-body">{{ faqr3 }}</div>
      </details>
      {%- endif -%}
      {%- assign faqp4 = product.metafields.rlp.faq_4_pergunta | default: "E se não servir?" -%}
      {%- assign faqr4 = product.metafields.rlp.faq_4_resposta | default: "Tem 30 dias para pedir troca de tamanho ou devolução. Basta responder ao e-mail da encomenda — tratamos do resto." -%}
      {%- if faqp4 != blank -%}
      <details>
        <summary>{{ faqp4 }}</summary>
        <div class="rlp-faq-body">{{ faqr4 }}</div>
      </details>
      {%- endif -%}
      {%- assign faqp5 = product.metafields.rlp.faq_5_pergunta | default: "" -%}
      {%- assign faqr5 = product.metafields.rlp.faq_5_resposta | default: "" -%}
      {%- if faqp5 != blank -%}
      <details>
        <summary>{{ faqp5 }}</summary>
        <div class="rlp-faq-body">{{ faqr5 }}</div>
      </details>
      {%- endif -%}
      {%- assign faqp6 = product.metafields.rlp.faq_6_pergunta | default: "" -%}
      {%- assign faqr6 = product.metafields.rlp.faq_6_resposta | default: "" -%}
      {%- if faqp6 != blank -%}
      <details>
        <summary>{{ faqp6 }}</summary>
        <div class="rlp-faq-body">{{ faqr6 }}</div>
      </details>
      {%- endif -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "RLP · Tamanhos e FAQ",
  "tag": "section",
  "class": "rlp-sec",
  "settings": [
    {
      "type": "paragraph",
      "content": "Os textos desta secção vêm do produto (Metafields → rlp), não daqui — assim servem para qualquer produto que use este modelo. Edite em Produtos → [o produto] → Metafields, ou peça para os preencherem por si."
    }
  ],
  "presets": [
    {
      "name": "RLP · Tamanhos e FAQ"
    }
  ]
}
{% endschema %}
